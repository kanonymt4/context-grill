# grounded の認証情報。.env は必ず .gitignore に入れてください。

# GitHub（private リポジトリを読む場合に必要。repo スコープの PAT）
GITHUB_TOKEN=

# Atlassian（Confluence / Jira 共通）
# API トークン: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# 推論用 LLM（llm.provider に応じて 1 つ）
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=            # openai-compat（Ollama / vLLM / LM Studio / Azure など）

# 埋め込み（retrieval.embedding.provider を none 以外にする場合）
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
